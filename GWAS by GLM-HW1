# Load files to perform PCA and incorporate PCs as cofactors for GWAS (Question 1) 
phenotype = read.table(file="C:/Users/51970/OneDrive - Washington State University (email.wsu.edu)/2025 courses/Spring semester 2025/BIO 545/Gwas data-Muluken/phenotype.txt", head = T)
covariate = read.table(file="C:/Users/51970/OneDrive - Washington State University (email.wsu.edu)/2025 courses/Spring semester 2025/BIO 545/Gwas data-Muluken/covariate.txt", head = T)
