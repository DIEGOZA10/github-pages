# Remove the first column (Taxa ID) if it's present and should not be included in the analysis
genotype_matrix <- as.matrix(genotype_data[, -1])
# Check variance of each column for the genotype data
column_variances <- apply(genotype_matrix, 2, var)
# Identify columns with zero variance
zero_variance_columns <- which(column_variances == 0)
zero_variance_columns
# Remove columns with zero variance
genotype_matrix_cleaned <- genotype_matrix[, column_variances != 0]

# Perform PCA on the genotype data (to capture population structure)
pca <- prcomp(genotype_matrix_cleaned, scale. = TRUE)
# Extract the top 10 principal components (adjust as needed)
pca_data <- pca$x[, 1:10]

# Combine PCA with the covariate data
covariate_matrix <- cbind(covariate, pca_data)
covariate_matrix<-as.data.frame(covariate_matrix)
