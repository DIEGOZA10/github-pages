###Perform GWAS Using GLM with QQman package
# Prepare the response variable (trait=plant height (PH))
trait <- phenotype$PH  # Change "PH" to the actual column name of your phenotype data

# Initialize an empty data frame to store results
results <- data.frame(SNP = colnames(genotype_matrix_cleaned), p_value = NA)
```

```{r}
# Perform GWAS for each SNP using GLM (Question 2 and 4)
for (i in 1:ncol(genotype_matrix_cleaned)) {
     snp_data <- genotype_matrix_cleaned[, i]
  # Create a data frame for the current SNP and covariates
  data_for_model <- data.frame(trait = trait, snp_data = snp_data, covariate_matrix)
  
  # Fit a logistic regression model 
  model <- glm(trait ~ snp_data + ., data = data_for_model, family = "gaussian")  # Change to "gaussian" for continuous traits
  
  # Store the p-value from the SNP coefficient
  results$p_value[i] <- summary(model)$coefficients[2, 4]  # p-value of the SNP coefficient
}

# Prepare data for Manhattan plot (using SNP information)
manhattan_data <- data.frame(
  SNP = results$SNP,
  CHR = snp_info$Chr,  # Corrected access to chromosome data
  BP = snp_info$BP,   # Corrected access to position data
  P = results$p_value
)
# Create Manhattan plot with the first 5 chrs
library(qqman)
manhattan(manhattan_data, main = "GWAS Manhattan Plot", col = c("blue4", "orange3","yellow","black","red"),
          ylim=c(0,10))

# Create QQ plot
qq(results$p_value)

## Genome-wide Threshold and Associated SNP's ----
p.vec <- as.vector(results$p_value)
type1= c(0.01, 0.05, 0.1, 0.2)
cutoff= quantile(p.vec, type1 ,na.rm=T) #calculation of cutoff using quantiles
genome.thresh <- cutoff[1] #with a type 1 error rate of 1%, we can excpect SNPs with p-values higher than this to be associated SNPs
associated.SNP.index <- results$p_value <= genome.thresh #creates index of associated SNPs
associated.SNPs <- which(associated.SNP.index) #let's us know which of our 4299 markers are our significant ones
snp.names <- colnames(genotype_matrix) #get names of all snps
associated.SNP.names <- snp.names[associated.SNPs] #get names of associated snps
print(paste("The associated SNPs are ", paste(associated.SNP.names, collapse = ", "), sep = "")) #output the names of associated snps

GWASP_manhattan <- manhattan_plot(marker_map = snp_info, pvals = p.vec, QTN_index = associated.SNPs) #create manhattan plot
GWASP_manhattan <- GWASP_manhattan + geom_hline(yintercept = -log10(genome.thresh), linetype = "dashed", color = "black") #add significance threshold

#view updated manhattan plot
GWASP_manhattan 

#After calculating our genome-wide threshold for a Type I error rate of 1%, we observe that we have 43 significantly associated SNPs.
#Sub set genotype data
sig.snps.geno <- genotype_data[,associated.SNPs] #subset genotype data of only the significant SNPs
