#Load files to run simulation with GWASbycor function-30 replicates (question 5)

snp_info <- read.table(file="C:/Users/51970/OneDrive - Washington State University (email.wsu.edu)/2025 courses/Spring semester 2025/BIO 545/Gwas data-Muluken/SNPinfo.txt", header = TRUE)
genotype_data = read.table(file="C:/Users/51970/OneDrive - Washington State University (email.wsu.edu)/2025 courses/Spring semester 2025/BIO 545/Gwas data-Muluken/Numeric_gen2.txt", head = T)

# Replicate 30 times and plot the means with GWASbycor function
nrep=30
set.seed(99164)
statRepGWASbycor=replicate(nrep, {
  mySim=G2P(X=genotype_data[,-1],h2=.75,alpha=1,NQTN=10,distribution="norm")
  p=GWASbyCor(X=genotype_data[,-1],y=mySim$y)
  seqQTN=mySim$QTN.position
  myGWAS=cbind(snp_info,t(p),NA)
  myStat=GAPIT.FDR.TypeI(WS=c(1e0,1e3,1e4,1e5), GM=snp_info,seqQTN=mySim$QTN.position,GWAS=myGWAS,maxOut=100,MaxBP=1e10)
})
str(myStat)
# Power
power=statRepGWASbycor[[2]]
# FDR
s.fdr=seq(3,length(statRepGWASbycor),7)
fdr=statRepGWASbycor[s.fdr]
fdr.mean=Reduce ("+", fdr) / length(fdr) #fdr is a list of vectors, Reduce("+", fdr) will sum the vectors element-wise.
#AUC
s.auc.fdr=seq(6,length(statRepGWASbycor),7)
auc.fdr=statRepGWASbycor[s.auc.fdr]
auc.fdr.mean=Reduce ("+", auc.fdr) / length(auc.fdr)

# Plots of power vs FDR
theColor=rainbow(4)
# theColor=c("red","blue","green")
plot(fdr.mean[,1],power , type="b", col=theColor [1],xlim=c(0,1))
for(i in 2:ncol(fdr.mean)){
  lines(fdr.mean[,i], power , type="b", col= theColor [i])
}
